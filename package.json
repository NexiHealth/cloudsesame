{
  "name": "cloudsesame",
  "version": "0.0.0",
  "description": "cloudsesame CLI",
  "type": "module",
  "bin": {
    "cloudsesame": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/cloudsesame.git"
  },
  "homepage": "https://github.com/OWNER/cloudsesame#readme",
  "bugs": "https://github.com/OWNER/cloudsesame/issues",
  "keywords": [
    "cli"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target node --minify --outfile dist/cli.js",
    "build:bin": "bun run scripts/build-binaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "release:snapshot": "goreleaser release --snapshot --clean",
    "prepublishOnly": "bun run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "license": "MIT"
}
