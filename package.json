{
  "name": "cloudsesame",
  "version": "0.0.0",
  "description": "cloudsesame CLI",
  "type": "module",
  "bin": {
    "cloudsesame": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexiHealth/cloudsesame.git"
  },
  "homepage": "https://github.com/NexiHealth/cloudsesame#readme",
  "bugs": "https://github.com/NexiHealth/cloudsesame/issues",
  "keywords": [
    "cli"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "build:bin": "bun run scripts/build-binaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "release:snapshot": "goreleaser release --snapshot --clean",
    "prepublishOnly": "bun run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview:vault": "bun run scripts/preview-vault.tsx",
    "render:banner": "bun run scripts/render-banner.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "zod": "^4.6.7"
  },
  "license": "Apache-2.0",
  "author": "Pol Vallverdu (https://polv.dev)",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json"
  }
}
